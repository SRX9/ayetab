---
const guarantees = [
  {
    title: "Offline-capable",
    body: "Works without a network once installed.",
  },
  {
    title: "Local storage only",
    body: "Theme, favorites, and recents stay on your machine.",
  },
  {
    title: "Open about permissions",
    body: "Side panel + storage — nothing more. Replacing the new tab needs no permission at all.",
  },
];
---

<section id="privacy" class="border-y border-line bg-tint">
  <div class="mx-auto grid w-full max-w-[1100px] gap-10 px-6 py-16 md:grid-cols-[1.1fr_0.9fr] md:py-24">
    <div>
      <p class="text-[12px] font-medium tracking-[0.08em] text-muted uppercase">
        Privacy by design
      </p>
      <h2 class="mt-2 max-w-[16ch] text-[28px] font-semibold leading-[1.15] tracking-tight text-ink md:text-[36px]">
        Your data never leaves the device.
      </h2>
      <p class="mt-4 max-w-[48ch] text-[15px] leading-relaxed text-muted">
        Every transform runs locally in the browser. No accounts, no telemetry pipelines, no “upload
        to process.” Export and import your preferences as JSON when you want a backup.
      </p>
    </div>
    <ul class="m-0 list-none border-t border-line p-0">
      {
        guarantees.map((item) => (
          <li class="border-b border-line py-4">
            <strong class="block text-[14px] font-semibold text-ink">{item.title}</strong>
            <span class="mt-1 block text-[13px] leading-relaxed text-muted">{item.body}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
