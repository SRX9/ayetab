---
const TOOL_COUNT = 100;
const EXTENSION_TOOL_COUNT = 99;

const categories = [
  { name: "Format & Validate", tools: "JSON · HTML · CSS · JS · XML · SQL · SCSS · LESS · ERB" },
  { name: "Encode & Decode", tools: "Base64 · Base64 Image · URL · HTML Entity · Backslash Escape" },
  { name: "Data Converter", tools: "YAML↔JSON · JSON↔CSV · Query String↔JSON · cURL→Code · JSON→Code" },
  { name: "Inspect & Debug", tools: "JWT · Unix Time · RegExp · Diff · Markdown · Cron · Certificate" },
  { name: "Generators", tools: "Hash · UUID · ULID · Random String · Lorem · QR Code" },
  { name: "Colour", tools: "Converter · Contrast · Palettes · Gradients · Blend · Eyedropper" },
  { name: "Images & Assets", tools: "Resize · Crop · Compress · SVG→CSS · Favicons · Sprite sheets" },
  { name: "Typography & Text", tools: "Case · Line Sort · Word Count · Ciphers · Shavian · Font tools" },
  { name: "Productivity", tools: "To-Do · Kanban · Pomodoro · Notes · Stopwatch · Habits" },
];
---

<section id="tools" class="mx-auto w-full max-w-[1080px] px-6 py-16 md:py-24">
  <p class="text-[12px] font-semibold tracking-[0.12em] text-accent uppercase">{TOOL_COUNT} tools</p>
  <h2 class="mt-2 max-w-[16ch] text-[30px] font-bold leading-[1.12] tracking-[-0.03em] text-ink md:text-[40px]">
    A full toolbox, one new tab.
  </h2>
  <p class="mt-4 max-w-[52ch] text-[15px] leading-relaxed text-muted md:text-[16px]">
    From everyday formatters to JWT debugging and habit tracking — all processing stays on your
    device.
  </p>

  <div class="mt-12 grid grid-cols-1 gap-x-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      categories.map((cat) => (
        <div class="border-t border-line/80 py-6">
          <h3 class="text-[15px] font-semibold text-ink">{cat.name}</h3>
          <p class="mt-1.5 text-[13px] leading-relaxed text-muted">{cat.tools}</p>
        </div>
      ))
    }
  </div>

  <p class="mt-8 max-w-[70ch] text-[13px] leading-relaxed text-muted">
    Draw &amp; Write runs in the <a
      href="https://app.ayetab.dev"
      class="font-medium text-accent underline underline-offset-2">web app</a
    > — browser extension security rules block the library it needs, so the extension ships {
      EXTENSION_TOOL_COUNT
    } of the {TOOL_COUNT} and links out to the rest.
  </p>
</section>
