---
const year = new Date().getFullYear();

const productLinks = [
  { href: "/#features", label: "Features" },
  { href: "/#tools", label: "Tools" },
  { href: "/#install", label: "Install" },
];

const legalLinks = [
  { href: "/privacy", label: "Privacy" },
  { href: "/terms", label: "Terms" },
];
---

<footer class="border-t border-line/70">
  <div class="mx-auto grid w-full max-w-[1080px] gap-6 px-6 py-12">
    <a class="inline-flex items-center gap-2.5 font-semibold tracking-tight text-ink" href="/">
      <img src="/favicon.svg" width="26" height="26" alt="" />
      <span class="text-[16px]">AyeTab</span>
    </a>

    <div class="flex flex-wrap gap-x-8 gap-y-4">
      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Product">
        {
          productLinks.map((link) => (
            <a class="text-[13px] text-muted transition-colors hover:text-ink" href={link.href}>
              {link.label}
            </a>
          ))
        }
        <a
          class="text-[13px] text-muted transition-colors hover:text-ink"
          href="https://github.com/SRX9/ayetab"
          rel="noopener"
          target="_blank">GitHub</a
        >
      </nav>
      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Legal">
        {
          legalLinks.map((link) => (
            <a class="text-[13px] text-muted transition-colors hover:text-ink" href={link.href}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <p class="m-0 text-[12px] text-muted">
      © {year} AyeTab. Built for developers who stay local. No tracking cookies.
    </p>
  </div>
</footer>
