---
const TOOL_COUNT = 100;
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <img
      src="/images/hero-product.jpg"
      alt=""
      class="h-full w-full object-cover opacity-60"
      width="1920"
      height="1080"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-[#f7fbff]/40 via-[#f5f9fd]/78 to-[#f5f9fd]"
    >
    </div>
  </div>

  <div
    class="mx-auto flex w-full max-w-[1080px] flex-col items-center px-6 pb-20 pt-14 text-center md:pb-28 md:pt-20"
  >
    <img
      src="/images/logo-icon.png"
      width="148"
      height="148"
      alt=""
      class="reveal float-soft h-28 w-28 drop-shadow-[0_22px_48px_rgba(0,122,255,0.25)] md:h-36 md:w-36"
    />

    <h1
      class="reveal reveal-delay-1 mt-8 text-[52px] font-bold leading-none tracking-[-0.04em] text-ink md:text-[76px]"
    >
      AyeTab
    </h1>

    <p class="reveal reveal-delay-2 mt-4 max-w-[38ch] text-[17px] leading-relaxed text-muted md:text-[19px]">
      {TOOL_COUNT} developer tools on every new tab — offline, instant, and private by design.
    </p>

    <div class="reveal reveal-delay-3 mt-9 flex flex-wrap items-center justify-center gap-3">
      <a class="btn-primary rounded-2xl px-5 py-2.5 text-[14px] font-semibold" href="#install">
        Install extension
      </a>
      <a
        class="btn-ghost rounded-2xl px-5 py-2.5 text-[14px] font-semibold"
        href="https://app.ayetab.dev"
        rel="noopener"
      >
        Open the web app
      </a>
    </div>
  </div>
</section>
