---
const links = [
  { href: "/#features", label: "Features" },
  { href: "/#tools", label: "Tools" },
  { href: "/#privacy", label: "Privacy" },
];
---

<header class="glass-nav sticky top-0 z-50">
  <div class="mx-auto flex w-full max-w-[1080px] items-center gap-6 px-6 py-3">
    <a class="flex shrink-0 items-center gap-2.5 font-semibold tracking-tight text-ink" href="/">
      <img src="/favicon.svg" width="28" height="28" alt="" class="drop-shadow-sm" />
      <span class="text-[17px]">AyeTab</span>
    </a>

    <nav class="hidden flex-1 items-center gap-1 sm:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            class="rounded-lg px-2.5 py-1.5 text-[14px] text-muted transition-colors hover:bg-white/60 hover:text-ink"
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a class="btn-primary ms-auto shrink-0 rounded-xl px-3.5 py-1.5 text-[13px] font-semibold sm:ms-0" href="/#install">
      Install
    </a>
  </div>
</header>
