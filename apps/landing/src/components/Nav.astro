---
const links = [
  { href: "#features", label: "Features" },
  { href: "#tools", label: "Tools" },
  { href: "#privacy", label: "Privacy" },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-white/95">
  <div class="mx-auto flex w-full max-w-[1100px] items-center gap-6 px-6 py-3">
    <a class="flex shrink-0 items-center gap-2 font-semibold text-ink" href="/">
      <img src="/favicon.svg" width="22" height="22" alt="" class="rounded-sm" />
      <span class="text-[15px]">AyeTab</span>
    </a>

    <nav class="hidden flex-1 items-center gap-1 sm:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            class="rounded px-2 py-1 text-[14px] text-muted transition-colors hover:bg-tint hover:text-ink"
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      class="ms-auto shrink-0 rounded bg-ink px-3 py-1.5 text-[13px] font-medium text-white transition-opacity hover:opacity-90 sm:ms-0"
      href="#install"
    >
      Install
    </a>
  </div>
</header>
