---
const targets = [
  {
    name: "Chrome",
    body: "New tab page plus a persistent side panel. Install from the Chrome Web Store, or unpack a local build while developing.",
    cta: "Add to Chrome",
    href: "https://chromewebstore.google.com/",
    primary: true,
  },
  {
    name: "Firefox",
    body: "New tab page plus a native sidebar action, with the same tool suite. Built for Firefox’s extension model.",
    cta: "Add to Firefox",
    href: "https://addons.mozilla.org/",
    primary: true,
  },
  {
    name: "Web app",
    body: "Prefer a full tab? Open the web suite with every tool available in the browser.",
    cta: "Open AyeTab Web",
    href: "https://app.ayetab.dev",
    primary: false,
  },
];
---

<section id="install" class="mx-auto w-full max-w-[1100px] px-6 py-16 md:py-24">
  <p class="text-[12px] font-medium tracking-[0.08em] text-muted uppercase">Get AyeTab</p>
  <h2 class="mt-2 max-w-[18ch] text-[28px] font-semibold leading-[1.15] tracking-tight text-ink md:text-[36px]">
    Install in a minute. Use forever offline.
  </h2>
  <p class="mt-4 max-w-[52ch] text-[15px] leading-relaxed text-muted">
    Chrome or Firefox — the same new tab page, the same local toolkit, the same privacy model.
    Installing replaces your new tab; disable or remove AyeTab to put the default back.
  </p>

  <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3">
    {
      targets.map((target) => (
        <article class="flex min-h-full flex-col items-start gap-3 rounded-md border border-line p-5">
          <h3 class="text-[16px] font-semibold text-ink">{target.name}</h3>
          <p class="m-0 flex-1 text-[13px] leading-relaxed text-muted">{target.body}</p>
          <a
            class:list={[
              "mt-1 rounded px-3.5 py-2 text-[13px] font-medium transition-colors",
              target.primary
                ? "bg-ink text-white hover:opacity-90"
                : "border border-line text-ink hover:bg-tint",
            ]}
            href={target.href}
            rel="noopener"
            target={target.primary ? "_blank" : undefined}
          >
            {target.cta}
          </a>
        </article>
      ))
    }
  </div>
</section>
